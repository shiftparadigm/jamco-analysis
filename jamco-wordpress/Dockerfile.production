FROM wordpress:6.4-php8.1-apache

# Install MySQL client and WP-CLI
RUN apt-get update && \
    apt-get install -y default-mysql-client less && \
    curl -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && \
    chmod +x wp-cli.phar && \
    mv wp-cli.phar /usr/local/bin/wp && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy Jamco theme
COPY theme /var/www/html/wp-content/themes/jamco

# Copy database
COPY db-init/wordpress.sql /docker-entrypoint-initdb.d/

# Set proper permissions
RUN chown -R www-data:www-data /var/www/html/wp-content/themes/jamco && \
    chmod -R 755 /var/www/html/wp-content/themes/jamco

# Copy custom entrypoint
COPY setup-wordpress.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/setup-wordpress.sh

# Use custom entrypoint that wraps the original
ENTRYPOINT ["/usr/local/bin/setup-wordpress.sh"]
CMD ["apache2-foreground"]
