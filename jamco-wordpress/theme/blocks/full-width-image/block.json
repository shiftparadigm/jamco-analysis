{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jamco/full-width-image",
	"title": "Full Width Image",
	"category": "jamco",
	"icon": "format-image",
	"description": "Full width image block",
	"keywords": ["image", "full-width", "banner"],
	"textdomain": "jamco",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"attributes": {
		"image": {
			"type": "number",
			"default": 0
		},
		"caption": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"align": false,
		"html": false
	}
}
